PORT=3000
SOLANA_RPC_URL=https://api.devnet.solana.com
BASE_RPC_URL=https://mainnet.base.org

# PostgreSQL (Neon or local)
DATABASE_URL=

# VOVE ID — sandbox only (all four are dashboard credentials)
VOVE_ID_ENVIRONMENT=Sandbox
VOVE_ID_API_BASE_URL=https://api.voveid.net/v2
VOVE_ID_API_KEY=
VOVE_ID_PUBLIC_KEY=
VOVE_ID_KYB_FLOW_ID=
VOVE_ID_WEBHOOK_SECRET=

# Paytrie API v2 — CAD / USDC / CADC quotes and gated transaction execution
# Keep the API key server-side. A customer JWT and API key do NOT authorise StableX to transact as an MSB.
# Set true ONLY after Paytrie explicitly approves StableX's platform/partner arrangement in writing.
# Leave false/blank until approval is received. Quotes remain available independently.
PAYTRIE_PLATFORM_EXECUTION_APPROVED=false
PAYTRIE_API_KEY=

# AES-256-GCM key for encrypting beneficiary banking/wallet details (32 bytes, base64)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BENEFICIARY_ENCRYPTION_KEY=

# Internal provider-event ingestion token (rotate; never expose to browsers)
STABLEX_EVENT_INGESTION_TOKEN=

# Prototype operator token for manual lifecycle transitions
STABLEX_OPERATOR_TOKEN=

# Customer accounts & auth (step 1 of the customer flow)
# Passwords use scrypt; sessions are DB-backed bearer tokens.
# With ACCOUNTS_DEMO_CODE_DELIVERY=true the API response and server log include the
# 6-digit verification code so the flow works without an email/SMS provider.
# Set to false and wire a real provider before any production use.
ACCOUNTS_DEMO_CODE_DELIVERY=true
# Lifetime of issued session tokens in hours
SESSION_TTL_HOURS=72

# Honeycoin — read-only FX rate preview (set Sandbox while testing)
# Requires dashboard API key + public key before any endpoint works
HONEYCOIN_ENVIRONMENT=Sandbox
HONEYCOIN_API_KEY=
HONEYCOIN_PUBLIC_KEY=
# B2B auth/status + crypto on-ramp endpoints (keep both on the same environment)
HONEYCOIN_B2B_BASE_URL=https://api-v2.honeycoin.app/api/sandbox/b2b
HONEYCOIN_CRYPTO_BASE_URL=https://crypto.honeycoin.app/api/sandbox
# Legacy B2B fallback; leave blank when HONEYCOIN_B2B_BASE_URL is set
HONEYCOIN_API_BASE_URL=

# Paycrest — public rate preview needs NO credentials; order access requires approved KYB + key/secret
PAYCREST_API_BASE_URL=https://api.paycrest.io
PAYCREST_API_KEY=
PAYCREST_API_SECRET=

# Nomba — sandbox base URL is https://sandbox.nomba.com ; API key and webhook secret are dashboard credentials
NOMBA_API_BASE_URL=https://sandbox.nomba.com
NOMBA_API_KEY=
NOMBA_WEBHOOK_SECRET=

# Fincra — sandbox base URL is https://sandboxapi.fincra.com ; API key and webhook secret are dashboard credentials
FINCRA_API_BASE_URL=https://sandboxapi.fincra.com
FINCRA_API_KEY=
FINCRA_WEBHOOK_SECRET=

# Strails — no public sandbox base URL found; API key is a dashboard credential
STRAILS_API_BASE_URL=
STRAILS_API_KEY=

# Tetra — no public sandbox base URL found; API key is a dashboard credential
# CADD contract address (Base network) must also be obtained and added to config/assets.js
TETRA_API_BASE_URL=
TETRA_API_KEY=

# Apaylo — no public sandbox base URL found; API key is a dashboard credential
APAYLO_API_BASE_URL=
APAYLO_API_KEY=

# Bridge — exchange rates are indicative only; sandbox-mode API keys use the sandbox host
BRIDGE_ENVIRONMENT=Sandbox
BRIDGE_API_BASE_URL=https://api.sandbox.bridge.xyz/v0
BRIDGE_API_KEY=

# Circle — sandbox base URL is https://api-sandbox.circle.com ; API key is a dashboard credential
CIRCLE_API_BASE_URL=https://api-sandbox.circle.com
CIRCLE_API_KEY=

# CoinGecko — public reference price feed needs NO key for basic use; Pro API key optional
COINGECKO_API_KEY=

# Compliance gate (M1) — simulator until a real KYC/AML provider is configured.
# When KYC_API_* or AML_SCREENING_API_* are set, swap the simulator dispatch in
# services/complianceService.js for that provider.
COMPLIANCE_SIM_AUTO_APPROVE=true
COMPLIANCE_SIM_BLOCKED_NAMES=blocked person one,blocked person two
COMPLIANCE_SIM_BLOCKED_COUNTRIES=IR,KP,SY

# Placeholder names for the future real KYC / AML providers (readiness checks only)
KYC_API_BASE_URL=
KYC_API_KEY=
AML_SCREENING_API_BASE_URL=
AML_SCREENING_API_KEY=

# Shared secret configured in Honeycoin Dashboard > Developers > API Keys > Webhook Secrets
HONEYCOIN_WEBHOOK_SECRET=
