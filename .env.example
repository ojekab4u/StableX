PORT=3000
SOLANA_RPC_URL=https://api.devnet.solana.com
BASE_RPC_URL=https://mainnet.base.org

# PostgreSQL (Neon or local)
DATABASE_URL=

# VOVE ID — sandbox only
VOVE_ID_ENVIRONMENT=Sandbox
VOVE_ID_API_BASE_URL=https://api.voveid.net/v2
VOVE_ID_API_KEY=
VOVE_ID_PUBLIC_KEY=
VOVE_ID_KYB_FLOW_ID=
VOVE_ID_WEBHOOK_SECRET=

# Paytrie API v2 — live CAD / USDC / CADC quotes only
PAYTRIE_API_KEY=

# AES-256-GCM key for encrypting beneficiary banking/wallet details (32 bytes, base64)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BENEFICIARY_ENCRYPTION_KEY=

# Internal provider-event ingestion token (rotate; never expose to browsers)
STABLEX_EVENT_INGESTION_TOKEN=

# Prototype operator token for manual lifecycle transitions
STABLEX_OPERATOR_TOKEN=

# Honeycoin — read-only FX rate preview (set Sandbox while testing)
HONEYCOIN_ENVIRONMENT=Sandbox
HONEYCOIN_API_KEY=
HONEYCOIN_PUBLIC_KEY=
# Optional override; defaults to the documented sandbox or production B2B base URL
HONEYCOIN_API_BASE_URL=

# Paycrest — public rate preview needs no credentials; order access requires approved KYB
PAYCREST_API_BASE_URL=https://api.paycrest.io
PAYCREST_API_KEY=
PAYCREST_API_SECRET=
